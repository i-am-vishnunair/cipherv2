# Cipher - Competitor Blog Spy

## Environment
PORT=3000
DEMO_SITES_PORT=4000
DB_PATH=./data/cipher.db
LOG_LEVEL=info

## SMTP (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=cipher@example.com
SMTP_TO=admin@example.com

## Monitoring defaults
GLOBAL_CONCURRENCY=20
PER_HOST_CONCURRENCY=2
DEFAULT_POLL_INTERVAL_MS=60000
MIN_POLL_INTERVAL_MS=30000
MAX_POLL_INTERVAL_MS=900000
REQUEST_TIMEOUT_MS=10000
MAX_RESPONSE_SIZE_BYTES=5242880

## Auto-publishing (default OFF)
AUTO_PUBLISH_ENABLED=false
PUBLISH_WEBHOOK_URL=
PUBLISH_WP_URL=
PUBLISH_WP_USER=
PUBLISH_WP_APP_PASSWORD=
